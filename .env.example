# Copiá este archivo a .env y completá los valores reales.
# En EasyPanel: configurá estas variables directamente en la sección Environment.
# NO commitees tu .env real a git.

# ── Base de datos PostgreSQL ──────────────────────────────────────
# Formato: postgres://usuario:contraseña@host:5432/nombre_db
# En EasyPanel: usa el host interno del servicio PostgreSQL (ej: postgres:5432)
DATABASE_URL=postgres://lpsport:contraseña@postgres:5432/lpsport

# Si tu PostgreSQL externo requiere SSL (Heroku, Neon, Supabase, etc.):
# DATABASE_SSL=true

# ── Seguridad ─────────────────────────────────────────────────────
# Cadena aleatoria larga para firmar las cookies de sesión.
# Generá una con: openssl rand -hex 32
JWT_SECRET=reemplaza-con-una-cadena-aleatoria-larga

# ── Primer arranque: usuario admin inicial ────────────────────────
# Solo se usa si la tabla users está vacía (primera vez que inicia).
# Después podés cambiar la contraseña o crear más usuarios via /api/admin/users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña

# ── Servidor ──────────────────────────────────────────────────────
PORT=3000

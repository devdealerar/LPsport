# Copy to .env and fill in real values (or set these in easypanel env vars).
# DO NOT commit your real .env to git.

# Password for logging into the app.
APP_PASSWORD=changeme

# Random string used to sign session cookies. 32+ chars random.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Where the SQLite file lives. In Docker this is /data (mounted volume).
DATA_DIR=./data

# Port to listen on
PORT=3000
